# Copy to .env and adjust. Used by docker-compose.yml.
KURU_PORT=3000
# Require this token to use the app (leave empty for an open single-user instance).
KURU_ACCESS_TOKEN=
# Timezone for the study-day boundary of the initial user (the app adopts the device timezone).
KURU_TIMEZONE=UTC
KURU_MAX_UPLOAD_MB=2048
# Shown as "Source Code" link in Settings → About.
KURU_SOURCE_URL=
